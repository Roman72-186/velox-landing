PORT=3001
MAIL_TO=hello@queenofspades.tech
MAIL_FROM=hello@queenofspades.tech
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@queenofspades.tech
SMTP_PASS=replace_with_google_app_password
MAIL_DRY_RUN=false

# Кабинет супер-админа /admin/: пароль от 12 символов. Пусто — кабинет выключен.
ADMIN_PASSWORD=
# Каталог с leads.json. На VPS не задавать: systemd передаёт STATE_DIRECTORY=/var/lib/queenofspades.
# Локально по умолчанию ./data
# LEADS_DIR=
